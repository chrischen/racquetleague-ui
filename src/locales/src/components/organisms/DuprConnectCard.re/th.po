#: src/components/molecules/ConfirmDialog.re.mjs:33
#: src/components/organisms/DuprConnectCard.re.mjs:440
msgid "Cancel"
msgstr "ยกเลิก"

#: src/components/molecules/ConfirmDialog.re.mjs:41
msgid "Confirm"
msgstr "ยืนยัน"

#: src/components/organisms/DuprConnectCard.re.mjs:162
#: src/components/organisms/DuprConnectCard.re.mjs:246
#: src/components/organisms/DuprConnectCard.re.mjs:283
msgid "Couldn't reach DUPR. Please try again in a moment."
msgstr "เชื่อมต่อ DUPR ไม่ได้ กรุณาลองใหม่อีกครั้งในอีกสักครู่"

#: src/components/organisms/DuprConnectCard.re.mjs:507
msgid "Create one at mydupr.com or in the DUPR app"
msgstr "สร้างบัญชีได้ที่ mydupr.com หรือในแอป DUPR"

#: src/components/organisms/DuprConnectCard.re.mjs:476
msgid "Disconnect DUPR"
msgstr "ยกเลิกเชื่อมต่อ DUPR"

#: src/components/organisms/DuprConnectCard.re.mjs:527
msgid "Disconnect DUPR?"
msgstr "ยกเลิกเชื่อมต่อ DUPR?"

#: src/components/organisms/DuprConnectCard.re.mjs:504
msgid "Don't have a DUPR account?"
msgstr "ยังไม่มีบัญชี DUPR?"

#: src/components/molecules/DuprRatingBadge.re.mjs:55
msgid "doubles"
msgstr "คู่"

#: src/components/organisms/DuprConnectCard.re.mjs:456
msgid "DUPR"
msgstr "DUPR"

#: src/components/organisms/DuprConnectCard.re.mjs:172
msgid "DUPR couldn't complete the sign-in."
msgstr "DUPR ไม่สามารถลงชื่อเข้าใช้ให้เสร็จสมบูรณ์ได้"

#: src/components/organisms/DuprConnectCard.re.mjs:344
msgid "DUPR ID"
msgstr "DUPR ID"

#: src/components/organisms/DuprConnectCard.re.mjs:158
#: src/components/organisms/DuprConnectCard.re.mjs:519
msgid "DUPR linking isn't available right now."
msgstr "ขณะนี้ยังไม่สามารถเชื่อมต่อ DUPR ได้"

#: src/components/organisms/DuprConnectCard.re.mjs:416
msgid "DUPR login"
msgstr "เข้าสู่ระบบ DUPR"

#: src/components/organisms/DuprConnectCard.re.mjs:168
msgid "DUPR needs you to finish setting up your account before it can be linked. Follow the steps in the DUPR panel, then sign in again."
msgstr "DUPR ต้องการให้คุณตั้งค่าบัญชีให้เสร็จก่อนจึงจะเชื่อมโยงได้ ทำตามขั้นตอนในแผง DUPR แล้วลงชื่อเข้าใช้อีกครั้ง"

#: src/components/organisms/DuprConnectCard.re.mjs:187
#~ msgid "DUPR sent something we couldn't read. Please try again."
#~ msgstr "DUPR ส่งข้อมูลที่เราอ่านไม่ได้ กรุณาลองใหม่อีกครั้ง"

#: src/components/organisms/DuprConnectCard.re.mjs:320
msgid "Last synced"
msgstr "ซิงค์ล่าสุด"

#: src/components/organisms/DuprConnectCard.re.mjs:357
msgid "Link your DUPR account to use your verified DUPR rating here. While it's linked, it replaces your self-rating."
msgstr "เชื่อมต่อบัญชี DUPR เพื่อใช้เรตติ้ง DUPR ที่ยืนยันแล้วที่นี่ ระหว่างที่เชื่อมต่ออยู่ ระบบจะใช้แทนเรตติ้งที่คุณประเมินเอง"

#: src/components/organisms/DuprConnectCard.re.mjs:289
msgid "Linked"
msgstr "เชื่อมต่อแล้ว"

#: src/components/organisms/DuprConnectCard.re.mjs:294
msgid "Linking"
msgstr "กำลังเชื่อมต่อ"

#: src/components/organisms/DuprConnectCard.re.mjs:386
msgid "Linking your account…"
msgstr "กำลังเชื่อมต่อบัญชีของคุณ…"

#: src/components/organisms/DuprConnectCard.re.mjs:411
msgid "Loading DUPR…"
msgstr "กำลังโหลด DUPR…"

#: src/components/organisms/DuprConnectCard.re.mjs:401
#: src/components/organisms/DuprConnectCard.re.mjs:490
msgid "Log in with DUPR"
msgstr "เข้าสู่ระบบด้วย DUPR"

#: src/components/organisms/DuprConnectCard.re.mjs:297
#: src/components/organisms/DuprConnectCard.re.mjs:301
msgid "Not linked"
msgstr "ยังไม่ได้เชื่อมต่อ"

#: src/components/molecules/DuprRatingBadge.re.mjs:26
msgid "NR"
msgstr "NR"

#: src/components/molecules/DuprRatingBadge.re.mjs:37
msgid "provisional"
msgstr "ชั่วคราว"

#: src/components/organisms/DuprConnectCard.re.mjs:404
msgid "Sign in to DUPR to link your account. We store your DUPR ID and ratings — never your DUPR password."
msgstr "ลงชื่อเข้าใช้ DUPR เพื่อเชื่อมต่อบัญชีของคุณ เราจัดเก็บเฉพาะ DUPR ID และเรตติ้งของคุณ — ไม่เก็บรหัสผ่าน DUPR"

#: src/components/molecules/DuprRatingBadge.re.mjs:69
msgid "singles"
msgstr "เดี่ยว"

#: src/components/organisms/DuprConnectCard.re.mjs:156
msgid "That DUPR account is already linked to another player."
msgstr "บัญชี DUPR นี้เชื่อมต่อกับผู้เล่นคนอื่นแล้ว"

#: src/components/organisms/DuprConnectCard.re.mjs:160
msgid "That DUPR sign-in has expired. Please try again."
msgstr "การลงชื่อเข้าใช้ DUPR หมดอายุแล้ว กรุณาลองใหม่อีกครั้ง"

#: src/components/organisms/DuprConnectCard.re.mjs:170
msgid "You declined to share your DUPR data, so nothing was linked. Sign in again and choose Authorize to link."
msgstr "คุณปฏิเสธการแชร์ข้อมูล DUPR ของคุณ จึงไม่มีการเชื่อมโยงใดๆ ลงชื่อเข้าใช้อีกครั้งและเลือก \"อนุญาต\" เพื่อเชื่อมโยง"

#: src/components/organisms/DuprConnectCard.re.mjs:528
msgid "Your DUPR rating will stop being used here and your self-rating picker comes back."
msgstr "ระบบจะหยุดใช้เรตติ้ง DUPR ของคุณที่นี่ และตัวเลือกประเมินเรตติ้งด้วยตนเองจะกลับมา"
