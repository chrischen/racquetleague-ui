msgid "Create one at mydupr.com or in the DUPR app"
msgstr "可在 mydupr.com 或 DUPR 应用中创建"

#: src/components/organisms/DuprConnectCard.re.mjs:476
msgid "Disconnect DUPR"
msgstr "解除 DUPR 关联"

#: src/components/organisms/DuprConnectCard.re.mjs:527
msgid "Disconnect DUPR?"
msgstr "解除 DUPR 关联？"

#: src/components/organisms/DuprConnectCard.re.mjs:504
msgid "Don't have a DUPR account?"
msgstr "还没有 DUPR 账号？"

