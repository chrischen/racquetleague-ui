msgid "doubles"
msgstr "双打"

#: src/components/organisms/DuprConnectCard.re.mjs:456
msgid "DUPR"
msgstr "DUPR"

#: src/components/organisms/DuprConnectCard.re.mjs:172
msgid "DUPR couldn't complete the sign-in."
msgstr "DUPR 无法完成登录。"

#: src/components/organisms/DuprConnectCard.re.mjs:344
msgid "DUPR ID"
msgstr "DUPR ID"

#: src/components/organisms/DuprConnectCard.re.mjs:158
#: src/components/organisms/DuprConnectCard.re.mjs:519
msgid "DUPR linking isn't available right now."
msgstr "DUPR 关联暂时不可用。"

#: src/components/organisms/DuprConnectCard.re.mjs:416
msgid "DUPR login"
msgstr "DUPR 登录"

#: src/components/organisms/DuprConnectCard.re.mjs:168
msgid "DUPR needs you to finish setting up your account before it can be linked. Follow the steps in the DUPR panel, then sign in again."
msgstr "在关联之前，DUPR 需要您先完成账户设置。请按照 DUPR 面板中的步骤操作，然后重新登录。"

#: src/components/organisms/DuprConnectCard.re.mjs:187
#~ msgid "DUPR sent something we couldn't read. Please try again."
#~ msgstr "DUPR 返回的数据无法识别，请重试。"

#: src/components/organisms/DuprConnectCard.re.mjs:320
msgid "Last synced"
msgstr "上次同步"

#: src/components/organisms/DuprConnectCard.re.mjs:357
msgid "Link your DUPR account to use your verified DUPR rating here. While it's linked, it replaces your self-rating."
msgstr "关联你的 DUPR 账号，即可在此使用已验证的 DUPR 评级。关联期间将替代你的自评分。"

#: src/components/organisms/DuprConnectCard.re.mjs:289
msgid "Linked"
msgstr "已关联"

#: src/components/organisms/DuprConnectCard.re.mjs:294
msgid "Linking"
msgstr "关联中"

#: src/components/organisms/DuprConnectCard.re.mjs:386
msgid "Linking your account…"
msgstr "正在关联账号…"

#: src/components/organisms/DuprConnectCard.re.mjs:411
msgid "Loading DUPR…"
msgstr "正在加载 DUPR…"

#: src/components/organisms/DuprConnectCard.re.mjs:401
#: src/components/organisms/DuprConnectCard.re.mjs:490
msgid "Log in with DUPR"
msgstr "使用 DUPR 登录"

#: src/components/organisms/DuprConnectCard.re.mjs:297
#: src/components/organisms/DuprConnectCard.re.mjs:301
msgid "Not linked"
msgstr "未关联"

