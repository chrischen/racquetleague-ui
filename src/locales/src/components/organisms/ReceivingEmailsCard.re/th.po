#: src/components/organisms/ReceivingEmailsCard.re.mjs:268
msgid "Account email"
msgstr "อีเมลบัญชี"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:355
msgid "Add"
msgstr "เพิ่ม"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:337
msgid "Add a receiving email"
msgstr "เพิ่มอีเมลรับการจอง"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:276
msgid "Awaiting confirmation"
msgstr "รอการยืนยัน"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:372
msgid ""
"Bookings forwarded from it will no longer be added to your account. You can "
"add it again later."
msgstr "การจองที่ส่งต่อจากที่อยู่นี้จะไม่ถูกเพิ่มในบัญชีของคุณอีก คุณสามารถเพิ่มกลับได้ภายหลัง"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:262
msgid ""
"Bookings you forward to chris@pkuru.com are added to your account when they "
"come from one of these addresses. Add the other addresses you receive "
"booking confirmations at."
msgstr ""
"การจองที่คุณส่งต่อไปยัง chris@pkuru.com จะถูกเพิ่มในบัญชีของคุณเมื่อส่งมาจากที่อยู่เหล่านี้ "
"เพิ่มที่อยู่อื่นที่คุณใช้รับอีเมลยืนยันการจอง"

#: src/components/molecules/ConfirmDialog.re.mjs:33
msgid "Cancel"
msgstr "ยกเลิก"

#: src/components/molecules/ConfirmDialog.re.mjs:41
msgid "Confirm"
msgstr "ยืนยัน"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:273
msgid "Confirmed"
msgstr "ยืนยันแล้ว"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:344
msgid "name@example.com"
msgstr "name@example.com"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:242
msgid "Open it while signed in to pkuru to finish adding the address."
msgstr "เปิดลิงก์ขณะลงชื่อเข้าใช้ pkuru เพื่อเพิ่มที่อยู่ให้เสร็จสิ้น"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:254
msgid "Receiving emails"
msgstr "อีเมลรับการจอง"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:317
msgid "Remove"
msgstr "ลบ"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:371
msgid "Remove this receiving email?"
msgstr "ลบอีเมลรับการจองนี้หรือไม่"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:281
msgid "Resend"
msgstr "ส่งอีกครั้ง"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:142
#: src/components/organisms/ReceivingEmailsCard.re.mjs:149
msgid "Something went wrong. Please try again."
msgstr "เกิดข้อผิดพลาด โปรดลองอีกครั้ง"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:132
msgid "That address isn't on your account any more."
msgstr "ที่อยู่นี้ไม่ได้อยู่ในบัญชีของคุณแล้ว"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:130
msgid "That doesn't look like an email address."
msgstr "ดูเหมือนไม่ใช่ที่อยู่อีเมล"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:136
msgid "That's already your account email."
msgstr "นี่คืออีเมลบัญชีของคุณอยู่แล้ว"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:134
msgid "Too many emails sent. Please wait a minute and try again."
msgstr "ส่งอีเมลมากเกินไป โปรดรอสักครู่แล้วลองอีกครั้ง"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:138
msgid "We couldn't send the email. Try \\\"Resend\\\" in a moment."
msgstr "เราไม่สามารถส่งอีเมลได้ กรุณาลอง \\\\\\\"ส่งอีกครั้ง\\\\\\\" ในอีกสักครู่"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:241
msgid "We sent a confirmation link to"
msgstr "เราได้ส่งลิงก์ยืนยันไปที่"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:140
msgid "You can add up to 5 receiving emails. Remove one to add another."
msgstr "คุณเพิ่มอีเมลรับการจองได้สูงสุด 5 รายการ ลบหนึ่งรายการเพื่อเพิ่มใหม่"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:128
msgid "You've already added that address."
msgstr "คุณเพิ่มที่อยู่นี้แล้ว"
