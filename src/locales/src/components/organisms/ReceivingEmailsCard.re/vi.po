#: src/components/organisms/ReceivingEmailsCard.re.mjs:386
msgid "Account email"
msgstr "Email tài khoản"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:540
msgid "Add"
msgstr "Thêm"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:522
msgid "Add a receiving email"
msgstr "Thêm email nhận"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:406
msgid "Awaiting confirmation"
msgstr "Đang chờ xác nhận"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:557
msgid "Bookings forwarded from it will no longer be added to your account. You can add it again later."
msgstr "Các đặt chỗ được chuyển tiếp từ địa chỉ này sẽ không còn được thêm vào tài khoản của bạn. Bạn có thể thêm lại sau."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:376
msgid "Bookings you forward to chris@pkuru.com are added to your account when they come from one of these addresses. Add the other addresses you receive booking confirmations at."
msgstr "Các đặt chỗ bạn chuyển tiếp đến chris@pkuru.com sẽ được thêm vào tài khoản khi chúng được gửi từ một trong các địa chỉ này. Hãy thêm các địa chỉ khác mà bạn nhận email xác nhận đặt chỗ."

#: src/components/molecules/ConfirmDialog.re.mjs:33
#: src/components/organisms/ReceivingEmailsCard.re.mjs:496
msgid "Cancel"
msgstr "Hủy"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:389
msgid "Change"
msgstr "Thay đổi"

#: src/components/molecules/ConfirmDialog.re.mjs:41
msgid "Confirm"
msgstr "Xác nhận"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:403
msgid "Confirmed"
msgstr "Đã xác nhận"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:479
#: src/components/organisms/ReceivingEmailsCard.re.mjs:529
msgid "name@example.com"
msgstr "name@example.com"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:466
msgid "New account email"
msgstr "Email tài khoản mới"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:348
msgid "Open it to make it your account email. Until then, nothing changes."
msgstr "Mở liên kết để đặt làm email tài khoản. Trước đó, không có gì thay đổi."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:339
msgid "Open it while signed in to pkuru to finish adding the address."
msgstr "Hãy mở liên kết khi đang đăng nhập pkuru để hoàn tất việc thêm địa chỉ."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:368
msgid "Receiving emails"
msgstr "Email nhận"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:447
msgid "Remove"
msgstr "Xóa"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:556
msgid "Remove this receiving email?"
msgstr "Xóa email nhận này?"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:411
msgid "Resend"
msgstr "Gửi lại"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:490
msgid "Send link"
msgstr "Gửi liên kết"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:164
#: src/components/organisms/ReceivingEmailsCard.re.mjs:171
msgid "Something went wrong. Please try again."
msgstr "Đã xảy ra lỗi. Vui lòng thử lại."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:154
msgid "That address isn't on your account any more."
msgstr "Địa chỉ đó không còn trong tài khoản của bạn."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:152
msgid "That doesn't look like an email address."
msgstr "Đây có vẻ không phải là địa chỉ email."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:158
msgid "That's already your account email."
msgstr "Đó đã là email tài khoản của bạn."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:156
msgid "Too many emails sent. Please wait a minute and try again."
msgstr "Đã gửi quá nhiều email. Vui lòng đợi một chút rồi thử lại."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:160
msgid "We couldn't send the email. Try \\\"Resend\\\" in a moment."
msgstr "Chúng tôi không thể gửi email. Hãy thử \\\"Gửi lại\\\" sau giây lát."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:338
msgid "We sent a confirmation link to"
msgstr "Chúng tôi đã gửi liên kết xác nhận đến"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:347
msgid "We sent a link to"
msgstr "Chúng tôi đã gửi liên kết đến"

#: src/components/organisms/ReceivingEmailsCard.re.mjs:471
msgid "We'll email a link to the new address. Your current address stays on as a receiving email."
msgstr "Chúng tôi sẽ gửi liên kết đến địa chỉ mới. Địa chỉ hiện tại vẫn được giữ làm email nhận."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:162
msgid "You can add up to 5 receiving emails. Remove one to add another."
msgstr "Bạn có thể thêm tối đa 5 email nhận. Hãy xóa một email để thêm email khác."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:150
msgid "You've already added that address."
msgstr "Bạn đã thêm địa chỉ này rồi."

#: src/components/organisms/ReceivingEmailsCard.re.mjs:380
msgid "Your account has no email yet. The first address you confirm here becomes your account email."
msgstr "Tài khoản của bạn chưa có email. Địa chỉ đầu tiên bạn xác nhận ở đây sẽ trở thành email tài khoản."
