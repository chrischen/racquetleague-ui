msgid "Cancel"
msgstr "ยกเลิก"

#: src/components/organisms/StripePaymentEmbed.re.mjs:142
msgid "Complete payment"
msgstr "ชำระเงินให้เสร็จสิ้น"

#: src/components/organisms/StripePaymentEmbed.re.mjs:64
msgid "Could not save your card"
msgstr "ไม่สามารถบันทึกบัตรของคุณได้"

#: src/components/organisms/StripePaymentEmbed.re.mjs:87
msgid "Pay now"
msgstr "ชำระเงินตอนนี้"

#: src/components/organisms/StripePaymentEmbed.re.mjs:64
msgid "Payment failed"
msgstr "การชำระเงินล้มเหลว"

#: src/components/organisms/StripePaymentEmbed.re.mjs:86
msgid "Processing…"
