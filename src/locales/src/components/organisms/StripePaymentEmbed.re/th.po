#: src/components/organisms/StripePaymentEmbed.re.mjs:87
msgid "Save card"
msgstr "บันทึกบัตร"

#: src/components/organisms/StripePaymentEmbed.re.mjs:142
msgid "Save your card"
msgstr "บันทึกบัตรของคุณ"

#: src/components/organisms/StripePaymentEmbed.re.mjs:151
msgid ""
"Your card is saved now, not charged. The organizer will charge {amountLabel} "
"later."
msgstr ""
"บัตรของคุณถูกบันทึกไว้แล้ว ยังไม่มีการเรียกเก็บเงิน ผู้จัดจะเรียกเก็บ {amountLabel} ในภายหลัง"

#: src/components/organisms/StripePaymentEmbed.re.mjs:151
msgid ""
"Your card is saved now, not charged. The organizer will charge the "
"participation fee later."
msgstr "บัตรของคุณถูกบันทึกไว้แล้ว ยังไม่มีการเรียกเก็บเงิน ผู้จัดจะเรียกเก็บค่าเข้าร่วมในภายหลัง"

