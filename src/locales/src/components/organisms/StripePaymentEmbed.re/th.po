#: src/components/organisms/StripePaymentEmbed.re.mjs:151
#~ msgid "Your card is saved now, not charged. The organizer will charge {amountLabel} after the event."
#~ msgstr "บัตรของคุณถูกบันทึกไว้แล้ว ยังไม่มีการเรียกเก็บเงิน ผู้จัดจะเรียกเก็บ {amountLabel}หลังจบกิจกรรม"

