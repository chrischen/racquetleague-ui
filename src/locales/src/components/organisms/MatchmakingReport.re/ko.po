#: src/components/organisms/MatchmakingReport.re.mjs:1160
#~ msgid ""
#~ "Use Competitive+. The adaptive version opens with Balanced Round Robin "
#~ "while ratings are unknown, then switches to banded play as they settle — "
#~ "the fastest convergence available, with the best match quality in the "
#~ "field. About half the gain arrives in the first session and most of the "
#~ "rest by the end of the second (62% → 71% → 75% quality in a typical "
#~ "club), and because ratings persist, each session starts where the last "
#~ "one left off."
#~ msgstr ""
