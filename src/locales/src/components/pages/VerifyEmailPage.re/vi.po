#: src/components/pages/VerifyEmailPage.re.mjs:185
msgid "Account email changed"
msgstr "Đã đổi email tài khoản"

#: src/components/pages/VerifyEmailPage.re.mjs:175
msgid "Confirming your email…"
msgstr "Đang xác nhận email của bạn…"

#: src/components/pages/VerifyEmailPage.re.mjs:266
msgid "Couldn't confirm this email"
msgstr "Không thể xác nhận email này"

#: src/components/pages/VerifyEmailPage.re.mjs:208
#: src/components/pages/VerifyEmailPage.re.mjs:237
msgid "Email confirmed"
msgstr "Đã xác nhận email"

#: src/components/pages/VerifyEmailPage.re.mjs:194
#: src/components/pages/VerifyEmailPage.re.mjs:224
#: src/components/pages/VerifyEmailPage.re.mjs:253
#: src/components/pages/VerifyEmailPage.re.mjs:275
msgid "Go to profile settings"
msgstr "Đến cài đặt hồ sơ"

#: src/components/pages/VerifyEmailPage.re.mjs:218
msgid ""
"is now one of your receiving emails. Bookings you forward from it to "
"chris@pkuru.com will be added to your events."
msgstr ""
"giờ là một trong các email nhận của bạn. Các đặt chỗ bạn chuyển tiếp từ địa "
"chỉ này đến chris@pkuru.com sẽ được thêm vào sự kiện của bạn."

#: src/components/pages/VerifyEmailPage.re.mjs:247
msgid "is now your account email."
msgstr "giờ là email tài khoản của bạn."

#: src/components/pages/VerifyEmailPage.re.mjs:67
#: src/components/pages/VerifyEmailPage.re.mjs:83
msgid "Something went wrong. Please try again."
msgstr "Đã xảy ra lỗi. Vui lòng thử lại."

#: src/components/pages/VerifyEmailPage.re.mjs:59
#: src/components/pages/VerifyEmailPage.re.mjs:73
msgid "This address is already used by another pkuru account."
msgstr "Địa chỉ này đã được một tài khoản pkuru khác sử dụng."

#: src/components/pages/VerifyEmailPage.re.mjs:63
msgid ""
"This link doesn't work for this account. Make sure you're signed in to the "
"account that added the address, or send a new link from your profile "
"settings."
msgstr ""
"Liên kết này không dùng được cho tài khoản này. Hãy đảm bảo bạn đã đăng nhập "
"vào tài khoản đã thêm địa chỉ, hoặc gửi liên kết mới từ cài đặt hồ sơ."

#: src/components/pages/VerifyEmailPage.re.mjs:75
msgid ""
"This link doesn't work. Open it from the email again, or ask for a new one "
"from your profile settings."
msgstr ""
"Liên kết này không dùng được. Hãy mở lại từ email hoặc yêu cầu liên kết mới "
"từ cài đặt hồ sơ."

#: src/components/pages/VerifyEmailPage.re.mjs:81
msgid ""
"This link has already been used, or your account email has changed since it "
"was sent."
msgstr ""
"Liên kết này đã được sử dụng, hoặc email tài khoản của bạn đã thay đổi kể từ "
"khi liên kết được gửi."

#: src/components/pages/VerifyEmailPage.re.mjs:79
msgid "This link has expired. Ask for a new one from your profile settings."
msgstr "Liên kết này đã hết hạn. Hãy yêu cầu liên kết mới từ cài đặt hồ sơ."

#: src/components/pages/VerifyEmailPage.re.mjs:61
msgid "This link has expired. Send a new one from your profile settings."
msgstr "Liên kết này đã hết hạn. Hãy gửi liên kết mới từ cài đặt hồ sơ."

#: src/components/pages/VerifyEmailPage.re.mjs:65
msgid "This link is incomplete. Open it from the email again."
msgstr "Liên kết này chưa đầy đủ. Hãy mở lại từ email."

#: src/components/pages/VerifyEmailPage.re.mjs:77
msgid ""
"You're signed in to a different account. Sign out, then open the link again."
msgstr ""
"Bạn đang đăng nhập vào một tài khoản khác. Hãy đăng xuất rồi mở lại liên kết."

#: src/components/pages/VerifyEmailPage.re.mjs:189
msgid ""
"Your account now uses the new address. Your previous address is kept as a "
"receiving email, which you can remove in your profile settings."
msgstr ""
"Tài khoản của bạn giờ dùng địa chỉ mới. Địa chỉ trước đó được giữ làm email "
"nhận, bạn có thể xóa trong cài đặt hồ sơ."
