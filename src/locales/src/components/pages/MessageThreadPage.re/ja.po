msgid "Invitation thread"
msgstr "招待のスレッド"

#: src/components/organisms/MessageThread.re.mjs:646
msgid "Invited you"
msgstr "あなたを招待しました"

#: src/components/organisms/MessageThread.re.mjs:663
msgid "Message"
