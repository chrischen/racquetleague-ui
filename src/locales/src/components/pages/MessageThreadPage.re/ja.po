#: src/components/organisms/MessageThread.re.mjs:725
msgid "Messages with {name}"
msgstr "{name}さんとのメッセージ"

#: src/components/organisms/MessageThread.re.mjs:756
msgid "No recent messages with this person."
msgstr "この方との最近のメッセージはありません。"

#: src/components/pages/MessageThreadPage.re.mjs:104
msgid "Notifications"
msgstr "通知"

#: src/components/organisms/MessageThread.re.mjs:188
msgid "Reply to {name}"
msgstr "{name}さんに返信"

#: src/components/organisms/MessageThread.re.mjs:220
msgid "Send"
msgstr "送信"

#: src/components/organisms/MessageThread.re.mjs:220
msgid "Sending"
msgstr "送信中"

#: src/components/organisms/MessageThread.re.mjs:53
msgid "Sign in to reply."
