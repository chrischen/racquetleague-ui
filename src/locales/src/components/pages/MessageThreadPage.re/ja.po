msgstr "{firstName}さんから返信があると、返信できるようになります。"

#: src/components/organisms/MessageThread.re.mjs:654
msgid "You invited them"
msgstr "あなたが招待しました"

#: src/components/organisms/MessageThread.re.mjs:55
