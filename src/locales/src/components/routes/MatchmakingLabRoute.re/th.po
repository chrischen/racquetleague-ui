#: src/components/organisms/MatchmakingLab.re.mjs:1757
#~ msgid "skill spread evenly across the range, plus a ringer and a beginner"
#~ msgstr "ทักษะกระจายสม่ำเสมอทั่วช่วง บวกกับผู้เล่นเก่งมากและผู้เล่นมือใหม่"

#: src/components/organisms/MatchmakingLab.re.mjs:1204
#~ msgid "Standings at round {0}"
#~ msgstr "ตารางคะแนน ณ รอบที่ {0}"
