#, fuzzy
#~ msgid "· % chance the game ends level · same strategy, three rooms"
#~ msgstr "· 比赛以平局收场的概率 · 实线：Competitive+ · 虚线：随机、避免重复"

#: src/components/organisms/MatchmakingReport.re.mjs:427
#~ msgid ""
#~ "· % chance the game ends level · solid: Competitive+ · dashed: random, "
#~ "avoid repeats"
#~ msgstr "· 比赛以平局收场的概率 · 实线：Competitive+ · 虚线：随机、避免重复"

#: src/components/organisms/MatchmakingReport.re.mjs:932
#: src/components/organisms/MatchmakingReport.re.mjs:1020
#: src/components/organisms/MatchmakingReport.re.mjs:1114
#~ msgid "· % chance the game ends level, by true skill · higher is better"
#~ msgstr "· % 的概率游戏以平局结束，基于真实技术实力 · 越高越好"

#: src/components/organisms/MatchmakingReport.re.mjs:1026
