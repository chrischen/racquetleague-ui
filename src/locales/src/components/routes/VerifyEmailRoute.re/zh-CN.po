#: src/components/pages/VerifyEmailPage.re.mjs:129
msgid "Confirming your email…"
msgstr "正在确认您的邮箱…"

#: src/components/pages/VerifyEmailPage.re.mjs:166
msgid "Couldn't confirm this email"
msgstr "无法确认此邮箱"

#: src/components/pages/VerifyEmailPage.re.mjs:140
msgid "Email confirmed"
msgstr "邮箱已确认"

#: src/components/pages/VerifyEmailPage.re.mjs:156
#: src/components/pages/VerifyEmailPage.re.mjs:175
msgid "Go to profile settings"
msgstr "前往个人资料设置"

#: src/components/pages/VerifyEmailPage.re.mjs:150
msgid ""
"is now one of your receiving emails. Bookings you forward from it to "
"chris@pkuru.com will be added to your events."
msgstr ""
"现在是您的收件邮箱之一。您从此地址转发到 chris@pkuru.com 的预订将添加到您的活"
"动中。"

#: src/components/pages/VerifyEmailPage.re.mjs:63
msgid "Something went wrong. Please try again."
msgstr "出现错误，请重试。"

#: src/components/pages/VerifyEmailPage.re.mjs:55
msgid "This address is already used by another pkuru account."
msgstr "此地址已被另一个 pkuru 账户使用。"

#: src/components/pages/VerifyEmailPage.re.mjs:59
msgid ""
"This link doesn't work for this account. Make sure you're signed in to the "
"account that added the address, or send a new link from your profile "
"settings."
msgstr ""
"此链接不适用于此账户。请确认您已登录添加此地址的账户，或从个人资料设置发送新"
"链接。"

#: src/components/pages/VerifyEmailPage.re.mjs:57
msgid "This link has expired. Send a new one from your profile settings."
msgstr "此链接已过期。请从个人资料设置发送新链接。"

#: src/components/pages/VerifyEmailPage.re.mjs:61
msgid "This link is incomplete. Open it from the email again."
msgstr "此链接不完整。请从邮件中重新打开。"
